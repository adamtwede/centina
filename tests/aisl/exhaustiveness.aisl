enum Verdict = A | B | C

function exhaustive(v: Verdict) -> Number:
    match v:
        case A:
            return 1
        case B:
            return 2
        case C:
            return 3
    return 0

function wildcard_ok(v: Verdict) -> Number:
    match v:
        case A:
            return 1
        case _:
            return 0
    return 0

function missing_case(v: Verdict) -> Number:
    match v:  # ~error: not exhaustive
        case A:
            return 1
    return 0

function wildcard_not_last(v: Verdict) -> Number:
    match v:
        case _:  # ~warn: wildcard case '_' is not last
            return 0
        case A:
            return 1
    return 0
