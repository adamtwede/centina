

assumed external function produce_unknown from "./unknown_producer.ts"

prime = produce_unknown() # prime nominally typed as Unknown

boundary UnknownBoundary(unknown: Unknown):
    get_unknown() -> UnknownAlpha
    set_unknown(UnknownAlpha)
    set_prime(Unknown)

unknown_boundary = UnknownBoundary(prime) # warning? just because two "things" are typed Unknown doesn't mean they are the same or convertible--that's the point.

function main():
    unknown_alpha = unknown_boundary.get_unknown() # unknown_alpha nominally typed as UnknownAlpha
    unknown_boundary.set_unknown(prime as UnknownAlpha) # Unknown to Unknown-like; explicit cast needed; emits a warning
    unknown_boundary.set_prime(unknown_alpha) # Unknown-like to Unknown; no need for an explicit cast; Unknown-like collapses nominally to Unknown (loss of type info); emits a warning