type Step
type Feedback
import type C from "./library.aisl"
import type D from "./library2.aisl"

enum Status = PENDING | DONE

function compose(s: Step) -> String:
	return "y"

function decompose(s: Step, f: Feedback, c: C, d: D) -> String:
	return "x"

count: Number = 1

external object lodash from "lodash"
