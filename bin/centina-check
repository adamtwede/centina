#!/usr/bin/env node
// Wrapper invoking the checker copy the SessionStart hook maintains at
// CLAUDE_PLUGIN_DATA — never the bundle's own ROOT copy, since DATA is the
// only location with node_modules actually installed. See
// docs/plugin-checker-install.md.

import { existsSync } from "node:fs"
import path from "node:path"
import { spawnSync } from "node:child_process"

const pluginData = process.env.CLAUDE_PLUGIN_DATA
if (!pluginData) {
  console.error("centina-check: CLAUDE_PLUGIN_DATA is not set.")
  process.exit(1)
}

const checkerDir = path.join(pluginData, "checker")
const nodeModulesDir = path.join(checkerDir, "node_modules")

if (!existsSync(nodeModulesDir)) {
  console.error(
    "centina-check: checker dependencies aren't installed; this should " +
      "resolve on the next session start, or check network access."
  )
  process.exit(1)
}

const result = spawnSync(
  "npx",
  ["tsx", path.join(checkerDir, "cli.ts"), ...process.argv.slice(2)],
  { cwd: checkerDir, stdio: "inherit" }
)

process.exit(result.status ?? 1)
